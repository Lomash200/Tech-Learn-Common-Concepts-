          "name": "6.1 Rate Limit - Single Request (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "console.log('✅ Request allowed. Rate limit counter incremented in Redis.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@test.com\",\n  \"password\": \"rahul123\"\n}"
            }
          }
        },
        {
          "name": "6.2 Rate Limit - Spam Test (Run this 20+ times fast → 429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response status:', pm.response.code);",
                  "if (pm.response.code === 429) {",
                  "    console.log('🚦 RATE LIMIT HIT! 429 Too Many Requests');",
                  "    console.log('TOPIC: Fixed Window Rate Limiting with Redis');",
                  "    pm.test('Rate limit triggered', () => pm.response.to.have.status(429));",
                  "} else {",
                  "    pm.test('Request allowed', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401]));",
                  "    console.log('Still within limit. Keep spamming to trigger 429!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fake@test.com\",\n  \"password\": \"wrongpass\"\n}"
            }
          }
        }
      ]
