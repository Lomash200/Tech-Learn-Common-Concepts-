    {
      "name": "📦 2. Products - Cache + Pagination + Streams",
      "description": "TOPIC: Caching(Redis), Pagination, Java Streams, @Transactional",
      "item": [
        {
          "name": "2.1 Get All Products (Offset Pagination) - 1st call = DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var res = pm.response.json();",
                  "pm.test('Has pagination fields', () => {",
                  "    pm.expect(res).to.have.property('content');",
                  "    pm.expect(res).to.have.property('totalElements');",
                  "    pm.expect(res).to.have.property('totalPages');",
                  "    pm.expect(res).to.have.property('last');",
                  "});",
                  "pm.test('Content is array', () => pm.expect(res.content).to.be.an('array'));",
                  "if (res.content.length > 0) {",
                  "    pm.collectionVariables.set('productId', res.content[0].id);",
                  "    console.log('📦 Saved productId:', res.content[0].id);",
                  "}",
                  "console.log('📊 Total products:', res.totalElements, '| Pages:', res.totalPages);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=5&sortBy=price",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" },
                { "key": "sortBy", "value": "price" }
              ]
            }
          }
        },
        {
          "name": "2.2 Get Products AGAIN - 2nd call = REDIS CACHE HIT ⚡",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["console.log('🔍 Watch app logs - this should NOT show DB query (cache hit!)');"]
