            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 16 Pro\",\n  \"description\": \"Latest Apple smartphone with titanium design\",\n  \"price\": 134900,\n  \"category\": \"ELECTRONICS\",\n  \"stock\": 25\n}"
            }
