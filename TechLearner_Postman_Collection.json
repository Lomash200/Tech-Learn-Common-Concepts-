        {
          "name": "2.5 Create Product (ADMIN only) - Triggers Kafka Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "var res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('newProductId', res.id);",
                  "pm.test('Product created', () => pm.expect(res.name).to.eql('iPhone 16 Pro'));",
                  "console.log('✅ Product created! Check app logs for:');",
                  "console.log('  1. INSERT SQL query');",
                  "console.log('  2. Kafka publish log: Published ProductCreated');",
                  "console.log('  3. Cache evicted (CacheEvict)');",
                  "console.log('  4. Kafka consumer log: Received ProductCreated');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
