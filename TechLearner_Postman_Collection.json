            }
          }
        },
        {
          "name": "2.8 Cursor-Based Pagination (Keyset) - Faster than OFFSET ⚡",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var res = pm.response.json();",
                  "pm.test('Returns array', () => pm.expect(res).to.be.an('array'));",
                  "console.log('⚡ TOPIC: Cursor/Keyset Pagination');",
                  "console.log('SQL: SELECT * FROM products WHERE id > :lastId LIMIT :size');",
                  "console.log('vs OFFSET: SELECT * FROM products LIMIT 5 OFFSET 10000 (SLOW!)');",
                  "if (res.length > 0) {",
                  "    var lastId = res[res.length-1].id;",
                  "    console.log('Next cursor (lastId):', lastId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/products/cursor?lastId=0&size=5",
              "query": [
                { "key": "lastId", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "2.9 Filter by Category (Java Streams Demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var res = pm.response.json();",
                  "pm.test('All products are ELECTRONICS', () => {",
                  "    res.forEach(p => pm.expect(p.category).to.eql('ELECTRONICS'));",
                  "});",
                  "console.log('🌊 TOPIC: Java Streams Pipeline');",
                  "console.log('.filter() → .filter() → .sorted() → .map() → .collect()');",
                  "console.log('Lazy evaluation: nothing executes until collect()!');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/products/category/ELECTRONICS"
          }
