    {
      "name": "🛒 3. Orders - N+1 Problem Demo",
      "description": "TOPIC: N+1 Problem Deep Dive, @Transactional Isolation, Pagination",
      "item": [
        {
          "name": "3.1 Create Order (Triggers Kafka + Async)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "var res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('orderId', res.id);",
                  "pm.test('Order has items', () => pm.expect(res.items).to.be.an('array').with.length.greaterThan(0));",
                  "console.log('🛒 Order created! id:', res.id, '| total:', res.totalAmount);",
                  "console.log('Check logs for:');",
                  "console.log('  1. REPEATABLE_READ isolation transaction');",
                  "console.log('  2. Stock update SQL');",
                  "console.log('  3. Kafka OrderPlaced event published async');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 4, \"quantity\": 1 },\n    { \"productId\": 5, \"quantity\": 2 }\n  ]\n}"
            }
          }
        },
        {
          "name": "3.2 ✅ Get My Orders FIXED (No N+1) - Count SQL queries!",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "console.log('👀 Watch app logs carefully...');",
                  "console.log('Expected: 1-2 SQL queries (JOIN FETCH)');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "console.log('✅ TOPIC: N+1 FIX - JOIN FETCH');",
                  "console.log('SQL generated: SELECT o FROM Order o JOIN FETCH o.user JOIN FETCH o.items');",
                  "console.log('Only 1 query! No matter how many orders.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders/fixed"
          }
