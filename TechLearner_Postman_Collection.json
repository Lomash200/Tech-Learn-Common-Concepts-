            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 (served from cache)', () => pm.response.to.have.status(200));",
                  "console.log('⚡ If no SQL in app logs = CACHE HIT! Redis served this response.');",
                  "console.log('💡 TOPIC: Cache-Aside Pattern - @Cacheable in ProductService');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=5&sortBy=price",
